# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# OpenRouter — Rodrigo AI (server-side only, never VITE_ prefix)
OPENROUTER_API_KEY=

# Sentry — error tracking (opcional; sin DSN no se inicializa)
# Crear proyecto en https://sentry.io y pegar el DSN aquí
VITE_SENTRY_DSN=

# Vercel Analytics: no requiere env var; se activa solo al desplegar en Vercel
# y solo se carga si el usuario acepta cookies de analítica.

# Mapa de musikeers (/mapa): clave gratuita de CARTO para las teselas (carto.com/basemaps/apikey).
# Es pública (va en la web). Sin ella el mapa sale con la marca de agua «API key required».
VITE_CARTO_KEY=
# Emuladores en otros puertos (por defecto 9099 y 8080)
# VITE_EMULADOR_AUTH=9199
# VITE_EMULADOR_FIRESTORE=8180

# Entorno de pruebas (docs/AGENTES.md). Sin estas variables la app usa el Firebase de producción.
# VITE_ENTORNO=pruebas
# Desarrollo local contra los emuladores de Firebase (npx firebase-tools emulators:start)
# VITE_EMULADORES=1
