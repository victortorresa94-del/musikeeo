rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user owns the document (assuming doc ID is userID or field is userId)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Campos de confianza que solo un admin (consola / Admin SDK) puede tocar
    function touchesTrustFields() {
      return request.resource.data.keys().hasAny(['verified', 'stats'])
        && (resource == null
            || request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'stats']));
    }

    // Users Collection — PRIVADO (contiene email). Solo el dueño lee y escribe.
    // Lo que ven los demás está en publicProfiles.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && !touchesTrustFields();
      allow delete: if isOwner(userId);

      // Cancionero: letras y acordes que pega cada persona. Privadas, solo su dueño.
      match /canciones/{cancionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['titulo', 'artista', 'texto', 'ajustes', 'creadaEn', 'actualizadaEn'])
          && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 120
          && request.resource.data.artista is string && request.resource.data.artista.size() <= 120
          && request.resource.data.texto is string && request.resource.data.texto.size() <= 50000
          && request.resource.data.ajustes is map;
      }

      // Gustos que aprende el Feed (src/lib/recomendador.ts). Privados, solo su dueño.
      match /gustos/{gustoId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && gustoId == 'perfil'
          && request.resource.data.keys().hasOnly(['v', 'pesos', 'vistos', 'hechos', 't'])
          && request.resource.data.v == 1
          && request.resource.data.pesos is map && request.resource.data.pesos.size() <= 300
          && request.resource.data.vistos is map && request.resource.data.vistos.size() <= 400
          && request.resource.data.hechos is map && request.resource.data.hechos.size() <= 400;
      }

      // Repertorios del cancionero (el orden de las canciones de un bolo). Privados.
      match /repertorios/{repertorioId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['nombre', 'fecha', 'canciones', 'creadaEn', 'actualizadaEn'])
          && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 120
          && request.resource.data.canciones is list && request.resource.data.canciones.size() <= 300;
      }
    }

    // Perfil público (sin email). Lectura abierta; el dueño solo escribe campos permitidos.
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
             'uid', 'displayName', 'photoURL', 'primaryMode', 'activeModes',
             'location', 'bio', 'skills', 'genres', 'tags', 'createdAt',
             'verified', 'stats'
           ])
        && !touchesTrustFields();
      allow delete: if isOwner(userId);
    }

    // Artists Collection
    match /artists/{artistId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.artistName is string
        && request.resource.data.artistName.size() > 0
        && request.resource.data.artistName.size() <= 100;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // Providers Collection
    match /providers/{providerId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() > 0
        && request.resource.data.businessName.size() <= 100;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // Organizers (salas y promotores): mismo trato que providers
    match /organizers/{organizerId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId);
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Only organizer can update/delete
      allow update, delete: if isOwner(resource.data.organizerId);
    }

    // Applications Collection
    // organizerId is denormalized into the doc on create so reads stay cheap
    // (no nested get() into events). Applicant and organizer can both read.
    match /applications/{applicationId} {
        allow create: if isAuthenticated()
            && request.resource.data.applicantId == request.auth.uid
            && request.resource.data.organizerId is string;
        allow read: if isOwner(resource.data.applicantId)
            || isOwner(resource.data.organizerId);
        // Only the organizer can accept / reject
        allow update: if isOwner(resource.data.organizerId);
    }
    

    // Chats Collection
    match /chats/{chatId} {
      // Allow create if authenticated and you are one of the participants
      allow create: if isAuthenticated()
        && request.resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants.size() == 2;
      // Read if you are a participant. resource == null permite que createChat
      // compruebe si el chat ya existe (si no, getDoc daba permission-denied).
      allow read: if isAuthenticated()
        && (resource == null || resource.data.participants.hasAny([request.auth.uid]));
      // Allow update if you are a participant (e.g. updating lastMessage)
      allow update: if isAuthenticated() && resource.data.participants.hasAny([request.auth.uid]);

      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        allow create: if isAuthenticated() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Listings Collection (Marketplace)
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Publicaciones del Feed (fotos y vídeos). Cualquiera las ve; solo el autor
    // las crea, edita el texto o las borra. Los me gusta y comentarios van aparte,
    // en interacciones/post_{id}.
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.mediaUrl is string
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 500
        && (!('etiquetas' in request.resource.data)
            || (request.resource.data.etiquetas is list && request.resource.data.etiquetas.size() <= 10))
        && (!('ciudad' in request.resource.data)
            || (request.resource.data.ciudad is string && request.resource.data.ciudad.size() <= 80));
      allow update: if isOwner(resource.data.authorId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption'])
        && request.resource.data.caption.size() <= 500;
      allow delete: if isOwner(resource.data.authorId);
    }

    // Me gusta y comentarios de lo que sale en el Feed: interacciones/{post_<id> | artista_<id>}.
    // Cualquiera los ve. Con sesión: un me gusta por persona (el id es su uid) y comentarios
    // propios. Los contadores se mueven de uno en uno y a la vez que el me gusta o el
    // comentario (los servicios lo hacen en una transacción).
    match /interacciones/{clave} {
      function contenido() {
        let d = request.resource.data;
        return (d.tipo == 'post'
            && exists(/databases/$(database)/documents/posts/$(d.refId))
            && get(/databases/$(database)/documents/posts/$(d.refId)).data.authorId == d.duenioId)
          || (d.tipo == 'artista'
            && exists(/databases/$(database)/documents/artists/$(d.refId))
            && get(/databases/$(database)/documents/artists/$(d.refId)).data.userId == d.duenioId);
      }
      function miMeGusta() {
        return /databases/$(database)/documents/interacciones/$(clave)/meGusta/$(request.auth.uid);
      }

      allow read: if true;
      // Nace con el primer me gusta o el primer comentario
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['tipo', 'refId', 'duenioId', 'likeCount', 'commentCount', 'creadoEn'])
        && clave == request.resource.data.tipo + '_' + request.resource.data.refId
        && contenido()
        && ((request.resource.data.likeCount == 1 && request.resource.data.commentCount == 0 && existsAfter(miMeGusta()))
            || (request.resource.data.likeCount == 0 && request.resource.data.commentCount == 1));
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount'])
        && ((request.resource.data.commentCount == resource.data.commentCount
              && ((request.resource.data.likeCount == resource.data.likeCount + 1 && !exists(miMeGusta()) && existsAfter(miMeGusta()))
                  || (request.resource.data.likeCount == resource.data.likeCount - 1 && exists(miMeGusta()) && !existsAfter(miMeGusta()))))
          || (request.resource.data.likeCount == resource.data.likeCount
              && (request.resource.data.commentCount == resource.data.commentCount + 1
                  || request.resource.data.commentCount == resource.data.commentCount - 1)));

      match /meGusta/{likerId} {
        allow read: if true;
        allow create: if isOwner(likerId)
          && request.resource.data.keys().hasOnly(['uid', 'clave', 'creadoEn'])
          && request.resource.data.uid == likerId
          && request.resource.data.clave == clave
          && getAfter(/databases/$(database)/documents/interacciones/$(clave)).data.likeCount
             == (exists(/databases/$(database)/documents/interacciones/$(clave))
                 ? get(/databases/$(database)/documents/interacciones/$(clave)).data.likeCount + 1 : 1);
        allow delete: if isOwner(likerId)
          && getAfter(/databases/$(database)/documents/interacciones/$(clave)).data.likeCount
             == get(/databases/$(database)/documents/interacciones/$(clave)).data.likeCount - 1;
      }

      match /comentarios/{comentarioId} {
        allow read: if true;
        allow create: if isAuthenticated()
          && request.resource.data.keys().hasOnly(['autorId', 'autorNombre', 'autorFoto', 'texto', 'creadoEn'])
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.autorNombre is string && request.resource.data.autorNombre.size() <= 80
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 500
          && getAfter(/databases/$(database)/documents/interacciones/$(clave)).data.commentCount
             == (exists(/databases/$(database)/documents/interacciones/$(clave))
                 ? get(/databases/$(database)/documents/interacciones/$(clave)).data.commentCount + 1 : 1);
        // Lo borra quien lo escribió o el dueño de la publicación o del perfil
        allow delete: if isAuthenticated()
          && (resource.data.autorId == request.auth.uid
              || get(/databases/$(database)/documents/interacciones/$(clave)).data.duenioId == request.auth.uid)
          && getAfter(/databases/$(database)/documents/interacciones/$(clave)).data.commentCount
             == get(/databases/$(database)/documents/interacciones/$(clave)).data.commentCount - 1;
      }
    }

    // «Qué me ha gustado a mí»: una consulta sobre todos los meGusta (collection group)
    match /{ruta=**}/meGusta/{likerId} {
      allow read: if true;
    }

    // Reports (DMCA/LSSI moderation queue) — users can create, only admins read
    match /reports/{reportId} {
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['listing', 'event', 'user', 'message', 'post']
        && request.resource.data.targetId is string
        && request.resource.data.reason is string;
      allow read, update, delete: if false;  // admin via Firebase console
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
